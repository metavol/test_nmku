    ],
    受賞: [],
  },
};
---
<Page title="業績" en="Achievements" description="金沢大学核医学の論文・学会発表・研究費・受賞の一覧。">
  <div class="two-col">
    <article class="main prose">
      <h2 id="pubs">論文・学会発表</h2>
      <div class="table-wrap"><table>
        <tbody>
          {pubs.map((p) => (
            <tr><th style="width:120px">{p.y}年</th><td>{p.items.map(([t, u], i) => (<>{i > 0 && '　／　'}<a href={u} target="_blank" rel="noopener">{t}（PDF）</a></>))}</td></tr>
          ))}
        </tbody>
      </table></div>
      <details>
        <summary>2022年以前の論文・学会発表（旧サイト）</summary>
        <ul style="columns:2;margin-top:12px">
          {legacyYears.map(([y, id]) => <li><a href={`${L}/papers/detail.php?d_no=${id}`} target="_blank" rel="noopener">{y}年</a></li>)}
          <li><a href={`${L}/papers/detail.php?d_no=33`} target="_blank" rel="noopener">核医学教室業績集 1968-2005</a></li>
          <li><a href={`${L}/papers/detail.php?d_no=38`} target="_blank" rel="noopener">書籍</a></li>
        </ul>
      </details>
      <p class="todo">将来的には PDF ではなく、1論文＝1行のデータ（JSON/CSV）から年別・著者別に自動生成する形にすると検索・更新が楽になります。</p>

      <h2 id="grants">研究費・受賞</h2>
      {Object.entries(grants).map(([fy, g]) => (
        <section>
          <h3>{fy}</h3>
          <div class="table-wrap"><table>
            <thead><tr><th>種別</th><th>課題名</th><th>研究者</th></tr></thead>
            <tbody>{g.研究費.map(([k, t, p]) => <tr><td style="white-space:nowrap">{k}</td><td>{t}</td><td style="white-space:nowrap">{p}</td></tr>)}</tbody>
          </table></div>
          {g.受賞.length > 0 && (
            <ul>{g.受賞.map(([a, p]) => <li><b>{a}</b>　{p}</li>)}</ul>
          )}
        </section>
      ))}
      <p>2023年度以前の研究費は<a href={`${L}/papers/detail.php?d_no=229`} target="_blank" rel="noopener">旧サイト</a>をご覧ください。</p>
    </article>
    <aside class="aside">
      <nav class="side-nav" aria-label="業績">
        <a href="#pubs"><span>論文・学会発表</span><span class="en">→</span></a>
        <a href="#grants"><span>研究費・受賞</span><span class="en">→</span></a>
      </nav>
    </aside>
  </div>
</Page>

<style>
  details { background: var(--paper-2); padding: 16px 20px; margin-bottom: 24px; }
  summary { cursor: pointer; font-weight: 500; color: var(--ink); }
</style>
