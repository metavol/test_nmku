const legacyYears: [string, number][] = [['2022', 253], ['2021', 200], ['2020', 160], ['2019', 139], ['2018', 116], ['2017', 101], ['2016', 95], ['2015', 94], ['2014', 82], ['2013', 14], ['2012', 15], ['2011', 16], ['2010', 17], ['2009', 18], ['2008', 19], ['2007', 20], ['2006', 21], ['2005', 22], ['2004', 23], ['2003', 24], ['2002', 25], ['2001', 26], ['2000-1995', 30]];

