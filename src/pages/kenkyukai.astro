---
import Page from '../layouts/Page.astro';
import { SITE } from '../lib/site';
const past = [
  ['第70回', '2018年7月28日', 'ホテル金沢', '亀山智樹（富山県立済生会富山病院 循環器内科）', 'テーマ「マルチモダリティにおける心筋シンチの有用性」、特別講演：川村一太'],
  ['第69回', '2018年2月3日', 'ホテル金沢', '臼田和生（富山県立中央病院）', 'テーマ「重症心不全」、特別講演：坂田泰史'],
  ['第67回', '2017年2月4日', 'ホテル金沢', '藤野晋（福井県立病院）', '特別講演：真鍋治（PETによる心疾患評価）'],
  ['第66回', '2016年7月30日', 'ホテル金沢', '清川裕明（富山市民病院）', '特別講演：坂谷知彦'],
  ['第65回', '2016年2月6日', 'ホテル金沢', '麻野井英次（射水市民病院）', '一般演題'],
  ['第64回', '2015年7月25日', 'ホテル金沢', '夛田浩（福井大学 循環器内科）', 'テーマ「advanced cardiac modality」、特別講演：慶田毅彦'],
  ['第63回', '2015年2月7日', 'ホテル金沢', '絹谷清剛、中嶋憲一（金沢大学）', '特別講演：常喜信彦'],
  ['第62回', '2014年7月12日', 'ホテル金沢', '分校久志、堀田祐紀（金沢循環器病院）', '特別講演：西垣和彦'],
  ['第61回', '2014年2月1日', 'ホテル金沢', '水野清雄（福井循環器病院）', '特別講演：中川正康'],
  ['第60回', '2013年7月27日', 'ホテル金沢', '井内和幸、三崎拓郎（富山県済生会富山病院）', '特別講演：西村眞人、西村重敬'],
  ['第59回', '2013年2月2日', 'ホテル金沢', '北山道彦（金沢医科大学病院）', '特別講演：大久保信司'],
];
---
<Page title="北陸循環器核医学研究会" en="Hokuriku Nuclear Cardiology Meeting" crumbs={[{ href: '/about/', label: '教室紹介' }]} description="1983年から続く北陸地区の心臓核医学研究会。">
  <div class="prose">
    <p>北陸循環器核医学研究会は、循環器系の診療に携わる核医学・放射線科医、循環器内科医、心臓血管外科医、診療放射線技師を中心に、1983年から定期的に開催されています。特別講演、教育講演、トピックス、一般演題のセッションを設けています。過去の研究会記録は金沢大学リポジトリに掲載されています。</p>
    <p class="todo">第71回以降（2018年〜）の開催記録と、次回開催予定を追加してください。第76回は2022年8月に開催されています。</p>
    <h2>開催記録</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>回</th><th>日程</th><th>会場</th><th>当番幹事</th><th>主な内容</th></tr></thead>
      <tbody>{past.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <h2>事務局</h2>
    <ul>
      <li>{SITE.address}　金沢大学医薬保健研究域医学系 核医学</li>
      <li>電話 {SITE.tel} ／ FAX {SITE.fax} ／ {SITE.email}</li>
    </ul>
  </div>
</Page>
