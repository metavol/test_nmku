---
import Page from '../layouts/Page.astro';
import { SITE } from '../lib/site';
const past = [
  ['第93回', '2020年12月5日', 'Web（Zoom）', '特別講演「乳癌骨転移における画像評価の意義」内藤陽一（国立がん研究センター東病院）'],
  ['第92回', '2019年12月14日', '金沢ニューグランドホテル', '特別講演「前立腺癌に対する次世代のPET/CT検査」中本裕士'],
  ['第91回', '2019年5月18日', '金沢ニューグランドホテル', '特別講演「多変量解析から機械学習まで」中嶋憲一'],
  ['第90回', '2018年12月1日', '金沢ニューグランドホテル', '特別講演「IgG4関連疾患」川野充弘、「認知症診療における核医学検査」木村成志'],
  ['第89回', '2018年5月19日', '金沢ニューグランドホテル', '特別講演「全身用CZT SPECT/CT」松成一朗'],
  ['第88回', '2017年12月2日', '金沢ニューグランドホテル', '特別講演：澤木正孝、上村博司'],
  ['第87回', '2017年5月20日', '金沢ニューグランドホテル', '特別講演「FDG-PET/CTを用いた悪性腫瘍治療効果判定」長町茂樹'],
  ['第86回', '2016年12月3日', '金沢ニューグランドホテル', '帰朝講演：若林大志、特別講演：吉永恵一郎'],
  ['第85回', '2016年5月21日', '金沢ニューグランドホテル', '特別講演「神経内分泌腫瘍におけるソマトスタチン受容体イメージング」中本裕士'],
];
---
<Page title="核医学カンファレンス" en="Nuclear Medicine Conference" crumbs={[{ href: '/about/', label: '教室紹介' }]} description="北陸地区の核医学カンファレンス。症例検討と特別講演。">
  <div class="prose">
    <p>北陸地区の核医学に関わる医師・診療放射線技師を対象に、症例検討（Q&amp;A形式、症例報告形式、判断に迷う症例の提示）と特別講演を行うカンファレンスです。多くは土曜日の午後に開催しています。</p>
    <p class="todo">第94回以降の開催記録と、次回開催予定を追加してください。</p>
    <h2>開催記録</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>回</th><th>日程</th><th>会場</th><th>主な内容</th></tr></thead>
      <tbody>{past.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <h2>症例の応募</h2>
    <p>症例は電子メールで事務局にお送りください。症例カードの提出が必要です。画像は DICOM ではなく、匿名化した JPEG または PNG でお送りください。</p>
    <h2>事務局</h2>
    <ul>
      <li>{SITE.address}　金沢大学医薬保健研究域医学系 核医学</li>
      <li>電話 {SITE.tel} ／ FAX {SITE.fax} ／ {SITE.email}</li>
    </ul>
  </div>
</Page>
